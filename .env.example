# --- Core (required) ---
# Validated at startup by src/lib/env.ts (zod). Missing or invalid values
# fail fast with every offending variable listed.

# PostgreSQL connection string (must start with postgresql://)
# Host port is 5433 under docker compose (see docker-compose.yml); use 5432
# if you point at a host-native Postgres instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripmate

# Public base URL of the app
APP_URL=http://localhost:3000

# --- Core (optional) ---
# One of: development | production | test (defaults to development)
# NODE_ENV=development

# --- Later plans (documented, not validated yet) ---
# AUTH_SECRET=<openssl rand -base64 32>            # Plan 2: Better Auth
# SMTP_HOST=                                       # Plan 6: email
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="TripMate <no-reply@tripmate.example>"
# STORAGE_DRIVER=local                             # Plan 3: local | r2
# R2_ACCOUNT_ID=                                   # Plan 3: if STORAGE_DRIVER=r2
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
# META_PIXEL_ID=                                   # Plan 4: Meta CAPI
# META_CAPI_ACCESS_TOKEN=
# META_CAPI_TEST_CODE=
