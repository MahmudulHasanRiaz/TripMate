# --- Core (required) ---
# Validated at startup by src/lib/env.ts (zod). Missing or invalid values
# fail fast with every offending variable listed.

# PostgreSQL connection string (must start with postgresql://)
# Host port is 5433 under docker compose (see docker-compose.yml); use 5432
# if you point at a host-native Postgres instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripmate

# Vercel/Supabase: two URLs, two jobs.
#   DATABASE_URL         = TRANSACTION pooler (port 6543) — app/build runtime,
#                          serverless-friendly (src/db/connection.ts runs with
#                          prepare:false for it).
#   DATABASE_URL_MIGRATE = DDL-capable connection on port 5432: direct
#                          (db.<ref>.supabase.co:5432) or SESSION pooler
#                          (aws-0-<region>.pooler.supabase.com:5432) — used
#                          ONLY by deploy-time auto-migration
#                          (vercel-build -> scripts/auto-migrate.mjs).
#                          FORBIDDEN: transaction pooler (port 6543) or
#                          ?pgbouncer=true — DDL breaks there and the deploy
#                          fails fast.
# The role must own the schema. SKIP_DB_MIGRATE=1 disables auto-migration.
# Local sample (only needed when the runtime DATABASE_URL is not DDL-capable):
# DATABASE_URL_MIGRATE=postgresql://postgres:postgres@localhost:5432/tripmate

# Public base URL of the app
APP_URL=http://localhost:3000

# Better Auth signing/encryption secret (min 32 chars). Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Deploying the full stack to Portainer (docker-compose.portainer.yml)? Every
# variable a stack needs — with paste-ready samples — is listed under
# "Portainer stack" at the bottom of this file.

# --- Optional ---
# One of: development | production | test. Next.js sets NODE_ENV itself, so this
# line is informational only — src/lib/env.ts defaults to development when unset.
# NODE_ENV=development

# --- Email + object storage (optional) ---
# Read at runtime, not validated at boot — each has a dev-safe default (email is
# a no-op when SMTP_HOST is empty; storage falls back to the local driver). The
# setup wizard at http://localhost:3000/setup writes these into .env for you; on
# Vercel/Portainer it shows copy-paste env blocks instead.

# SMTP. When SMTP_HOST is empty, outbound email no-ops (logs the intended send).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TripMate <no-reply@tripmate.example>"

# Object storage: local disk (default) or Cloudflare R2.
STORAGE_DRIVER=local
# Local driver root (default: storage/uploads — served ONLY through the
# hardened /uploads route, never as same-origin static files; SVGs uploaded to
# R2 are served from the bucket's public URL, so R2 SVG hardening — correct
# Content-Type + no public execution — must be configured bucket-side).
STORAGE_LOCAL_DIR=storage/uploads

# R2_* are read only when STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Meta CAPI conversion tracking (optional) ---
# Read at runtime, not validated at boot; the setup wizard can also set these.
# PIXEL_ID + ACCESS_TOKEN must BOTH be present to send server-side events
# (landing pages /l/<slug>, quote/subscription actions); leave either empty to
# disable CAPI entirely — the browser pixel keeps working regardless.
# META_PIXEL_ID=
# META_CAPI_ACCESS_TOKEN=
# TEST_CODE routes events to the Events Manager "Test events" tab only —
# use it while validating, never in real traffic.
# META_CAPI_TEST_CODE=

# --- Rate limiting (optional: multi-instance/serverless) ---
# Set both to route rate limits through Upstash Redis (fixed window, shared
# across instances). Unset = per-process sliding window (local/dev/single container).
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxx

# --- Portainer stack — variables to paste (NOT to copy into .env) ---
# Deploying docker-compose.portainer.yml via Portainer:
#   Stacks -> Add stack -> Build method: Repository
#   Repository URL:  <your clone of this repo>
#   Compose path:    docker-compose.portainer.yml
#   Environment variables: paste the key=value pairs below (advanced mode).
# The values are SAMPLES — replace them. Everything not required is optional;
# the defaults are the compose defaults. Redeploy after changing any value.
# (The in-app setup wizard cannot write the stack's environment, so set
# variables here even when the wizard UI offers the same fields.)
#
# REQUIRED — the stack refuses to deploy without these, with an actionable
# error naming the variable:
#
#   AUTH_SECRET=<openssl rand -base64 32 output>
#   APP_URL=http://192.168.1.50:3000
#           # Must be the URL users actually open (http://<host-ip>:<APP_PORT>
#           # or your https domain). Auth callbacks and links derive from it.
#           # Behind an NGINX reverse proxy: the public https://domain — and
#           # point the proxy upstream at http://<docker-host>:<APP_PORT>.
#
# PORTS — every port is an independent variable; assign whichever host ports
# you want (no other variable references them):
#
#   APP_PORT=3000                  # host port for the app (default 3000)
#   POSTGRES_PORT=5433             # host port for Postgres (default 5433)
#
# DATABASE — both modes are fully automatic; choose ONE.
#
# (A) INTERNAL PostgreSQL (default — nothing to set). Postgres runs as part of
#     the same stack. DATABASE_URL is derived INSIDE the app at boot from the
#     variables below (scripts/derive-db-url.mjs), so custom values are set
#     ONCE and both ends receive them:
#
#   POSTGRES_DB=tripmate           # database name (default tripmate)
#   POSTGRES_PASSWORD=postgres     # database password — CHANGE THIS before
#                                  # the first deploy (see caveat below)
#   POSTGRES_USER=postgres         # optional (default postgres)
#         # Caveat: an existing tripmate_pgdata volume keeps the credentials it
#         # was initialized with. Change these BEFORE the first deploy, or
#         # recreate the volume (destroys data), or ALTER USER inside it.
#         # Passwords with @ : # % / are safe — the derived URL is
#         # percent-encoded automatically.
#
# (B) EXTERNAL database — set the URL(s) instead; the bundled Postgres stays
#     running but is unused:
#
#   DATABASE_URL=postgresql://user:pass@host:5432/dbname
#   DATABASE_URL_MIGRATE=          # only when DATABASE_URL is not DDL-capable
#                                  # (e.g. Supabase transaction pooler :6543):
#                                  # a direct or SESSION-pooler :5432 URL. See
#                                  # the "Vercel/Supabase" note near the top of
#                                  # this file and README → "Deploy env".
#   SKIP_DB_MIGRATE=1              # only to opt OUT of boot-time migrations
#
# OPTIONAL — email (SMTP) and object storage:
#
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_USER=user@example.com
#   SMTP_PASS=...
#   SMTP_FROM=TripMate <no-reply@tripmate.example>
#
#   STORAGE_DRIVER=local           # or: r2
#   R2_ACCOUNT_ID=...
#   R2_ACCESS_KEY_ID=...
#   R2_SECRET_ACCESS_KEY=...
#   R2_BUCKET_NAME=tripmate-media
#   R2_PUBLIC_URL=https://cdn.example.com
#           # R2_PUBLIC_URL is also a BUILD-time input (next/image whitelist,
#           # next.config.ts): after changing it, redeploy WITH a rebuild.
#
# OPTIONAL — Meta CAPI conversion tracking and shared rate limiting:
#
#   META_PIXEL_ID=...
#   META_CAPI_ACCESS_TOKEN=...
#   META_CAPI_TEST_CODE=           # test events only; never in real traffic
#   UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
#   UPSTASH_REDIS_REST_TOKEN=...
#
# After the first deploy: open https://<APP_URL>/setup once to create the
# superadmin (migrations create the schema automatically; they never seed
# demo content). Health check: https://<APP_URL>/api/health — it reports
# migrationsApplied/migrationsPending, and Portainer shows the container
# healthy/unhealthy from it.
